{
  "name": "tradingview-mcp",
  "version": "1.0.0",
  "description": "MCP bridge for TradingView Desktop via Chrome DevTools Protocol",
  "type": "module",
  "main": "src/server.ts",
  "bin": {
    "tv": "src/cli/index.ts"
  },
  "exports": {
    ".": "./src/server.ts",
    "./core": "./src/core/index.ts"
  },
  "scripts": {
    "start": "bun src/server.ts",
    "tv": "bun src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns '**/e2e.test.ts'",
    "test:live": "bun test tests/e2e.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chrome-remote-interface": "^0.33.2"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
